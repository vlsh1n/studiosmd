generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DistrictKey {
  botanica
  ciocana
  centru
  buiucani
  riscani
}

model Studio {
  id           String      @id @default(cuid())
  name_i18n    Json
  address_i18n Json
  district_key DistrictKey
  cover_images Json
  contacts     Json
  halls        Hall[]
}

model Hall {
  id             String   @id @default(cuid())
  studioId       String
  name_i18n      Json
  images         Json
  size_m2        Int?
  tags           String[]
  price_per_hour Int

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
}
